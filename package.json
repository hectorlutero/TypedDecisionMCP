{
  "name": "typed-decision-mcp",
  "version": "0.1.0",
  "description": "TypedDecisionMCP — Cursor MCP: local logit decisions (yesno/choice/score). No TypeSafe. 10x hop target.",
  "repository": {
    "type": "git",
    "url": "https://github.com/hectorlutero/TypedDecisionMCP.git"
  },
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "typed-decision-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "examples",
    "cursor",
    "README.md",
    "PLAN.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fetch-model": "tsx src/fetch-model.ts",
    "bench:logits": "tsx bench/logits.ts",
    "bench:baseline": "tsx bench/baseline.ts",
    "bench:baseline:prompts": "tsx bench/write-hop-prompts.ts",
    "bench:report": "tsx bench/report.ts",
    "check:independent": "node scripts/check-independent.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.4",
    "node-llama-cpp": "^3.14.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}