# Único motor de runtime: GGUF local (logits). Sem TypeSafe. Sem chave de LLM.
DECIDIR_MODEL=
# DECIDIR_AUTO=0.8
# DECIDIR_REVIEW=0.5

# HTTP (Cloud Agent)
# DECIDIR_HTTP_HOST=127.0.0.1
# DECIDIR_HTTP_PORT=8788
# DECIDIR_HTTP_TOKEN=

# GitHub (PAT). Só no .env local; nunca commitar o valor.
# GH_TOKEN=
# GITHUB_TOKEN=

# Aceitar baseline method=cursor-subagent no bench:report (proxy, não o aceite UI).
# DECIDIR_ACCEPT_PROXY=1

# Só o harness da fase 0 (gravar baseline). Não entra no server.
# BENCH_BASELINE_API_KEY=
# BENCH_BASELINE_BASE_URL=
# BENCH_BASELINE_MODEL=
